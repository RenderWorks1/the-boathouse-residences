NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Server-only — used by /api/enquiry to create enquiry documents.
SANITY_API_TOKEN=

# HubSpot — /api/enquiry forwards each enquiry to the client's HubSpot CRM.
# Portal/form IDs default to the client-supplied values in code; override here if needed.
HUBSPOT_PORTAL_ID=443280869
HUBSPOT_FORM_ID=3014cbd4-18fc-4568-badb-664fb87a4b96
# Internal property name of the HubSpot "How did you hear about us?" field.
# Leave blank until confirmed — an unknown field name makes HubSpot reject the whole submission.
HUBSPOT_SOURCE_FIELD=

# Meta Pixel — public by design, it ships in the browser snippet.
NEXT_PUBLIC_META_PIXEL_ID=1468336548648892
# Meta Conversions API — SERVER ONLY. Never give this a NEXT_PUBLIC_ prefix, never
# commit a real value. Set it in Vercel with: vercel env add META_CONVERSIONS_API_TOKEN
META_CONVERSIONS_API_TOKEN=
# Events Manager → Test Events code. Set on Preview only while testing, then delete
# it — while set, events go to the test stream instead of live reporting.
META_TEST_EVENT_CODE=
