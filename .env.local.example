NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Server-only — used by /api/enquiry to create enquiry documents.
SANITY_API_TOKEN=

# HubSpot — /api/enquiry forwards each enquiry to the client's HubSpot CRM.
# Portal/form IDs default to the client-supplied values in code; override here if needed.
HUBSPOT_PORTAL_ID=443280869
HUBSPOT_FORM_ID=3014cbd4-18fc-4568-badb-664fb87a4b96
# Internal property name of the HubSpot "How did you hear about us?" field.
# Leave blank until confirmed — an unknown field name makes HubSpot reject the whole submission.
HUBSPOT_SOURCE_FIELD=
